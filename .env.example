# Copy to .dev.vars for local Wrangler development. Never commit .dev.vars.
# Generate with: openssl rand -base64 32
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-one-time-token

# Optional Gmail SMTP alerts. Keep the app password in .dev.vars / Wrangler secrets.
SMTP_HOST=smtp.gmail.com
SMTP_USER=sender@example.com
SMTP_PASSWORD=
ADMIN_UPLOAD_EMAIL=admin@example.com
PUBLIC_APP_URL=https://family-vault.cipher126.workers.dev
