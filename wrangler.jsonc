{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "family-vault",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"upload_source_maps": true,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/robots.txt"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "family-vault-db",
			"database_id": "3b715611-918d-40b1-a17e-5c70b3bf2b1e",
			"migrations_dir": "db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "family-vault-photos",
			"preview_bucket_name": "family-vault-photos-dev"
		}
	],
	"vars": {
		"APP_ENV": "production",
		"SESSION_TTL_DAYS": "30"
	},
	"observability": {
		"enabled": true
	}
}